# Firebase Client SDK (Web Client Authentication)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vortex-workforce.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vortex-workforce
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vortex-workforce.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Firebase Admin SDK (Server Operations - Never expose to client)
FIREBASE_PROJECT_ID=vortex-workforce
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vortex-workforce.iam.gserviceaccount.com
# For private key, ensure newlines are escaped with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Machine Learning / Optimization Configuration
# Optional: External Python microservice URL if hosting Python separately
PYTHON_ML_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_ORG_ID=org_amc_default
